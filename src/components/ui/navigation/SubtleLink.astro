---
interface Props {
  href: string;
  class?: string;
  size?: 'sm' | 'base';
}

const { href, class: className, size = 'base' } = Astro.props;

const sizeClasses = {
  sm: 'text-xs sm:text-sm',
  base: 'text-sm sm:text-base',
};
---

<a
  href={href}
  class:list={[
    'font-title text-[color:var(--text-secondary)] underline decoration-[color:var(--border)] decoration-1 underline-offset-4 transition-colors duration-200 hover:text-[color:var(--nepal-red)] hover:decoration-[color:var(--nepal-red)]',
    sizeClasses[size],
    className,
  ]}
>
  <slot />
</a>
