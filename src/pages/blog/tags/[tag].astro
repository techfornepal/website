---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SubtleLink from '@/components/ui/navigation/SubtleLink.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tagMap = new Map<string, typeof posts>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = tag.toLowerCase().replace(/\s+/g, '-');
      if (!tagMap.has(slug)) tagMap.set(slug, []);
      tagMap.get(slug)!.push(post);
    }
  }

  return Array.from(tagMap.entries()).map(([tagSlug, tagPosts]) => ({
    params: { tag: tagSlug },
    props: {
      originalTag: tagPosts[0].data.tags.find(
        (t: string) => t.toLowerCase().replace(/\s+/g, '-') === tagSlug
      )!,
      posts: tagPosts
        .sort(
          (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
            (b.data.publishDate?.getTime() ?? 0) - (a.data.publishDate?.getTime() ?? 0)
        )
        .map((post: CollectionEntry<'blog'>) => ({
          slug: post.data.slug ?? post.id,
          title: post.data.title,
          excerpt: post.data.excerpt ?? '',
          date: post.data.publishDate,
          tags: post.data.tags ?? [],
        })),
    },
  }));
}

type BlogPost = {
  slug: string;
  title: string;
  excerpt: string;
  date: Date | undefined;
  tags: string[];
};

interface Props {
  originalTag: string;
  posts: BlogPost[];
}

const { originalTag, posts } = Astro.props as Props;
---

<BaseLayout title={`Posts tagged "${originalTag}" - Tech For Nepal`}>
  <main class="flex-1 pt-24 pb-16">
    <div class="mx-auto max-w-3xl px-4">
      <header class="mb-4 sm:mb-10">
        <h1
          class="text-3xl font-semibold tracking-tight sm:text-4xl"
          style="font-family: var(--font-title);"
        >
          Blog
        </h1>
        <p class="mt-4 text-base text-[color:var(--text-primary)]/70 sm:text-lg">
          Filtered by <span
            class="font-medium text-[color:var(--nepal-blue)]"
            style="font-family: var(--font-title);">#{originalTag}</span
          >
          <span class="ml-1.5 text-sm text-[color:var(--text-secondary)]">({posts.length})</span>
        </p>
        <SubtleLink href="/blog" class="mt-4 inline-block">&larr; ALL POSTS</SubtleLink>
      </header>

      <div>
        {
          posts.map((post, i) => (
            <div
              class:list={[
                'py-6',
                i < posts.length - 1 && 'border-b border-[color:var(--border-light)]',
              ]}
            >
              <a
                href={`/blog/${post.slug}`}
                class="group grid grid-cols-1 gap-1 sm:grid-cols-[140px_1fr] sm:gap-6"
              >
                <time
                  class="text-sm text-[color:var(--text-secondary)] tabular-nums sm:pt-0.5"
                  style="font-family: var(--font-title);"
                  datetime={post.date?.toISOString()}
                >
                  {post.date?.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
                <div>
                  <h2
                    class="text-base font-medium text-[color:var(--text-primary)] transition-colors duration-200 group-hover:text-[color:var(--secondary)] sm:text-lg"
                    style="font-family: var(--font-title);"
                  >
                    {post.title}
                  </h2>
                  {post.excerpt && (
                    <p class="mt-1 text-sm leading-relaxed text-[color:var(--text-primary)]/70">
                      {post.excerpt}
                    </p>
                  )}
                </div>
              </a>
              {post.tags.length > 0 && (
                <div class="mt-2 flex flex-wrap gap-1.5 sm:ml-[164px]">
                  {post.tags.map((tag: string) =>
                    tag === originalTag ? (
                      <span
                        class="text-sm font-semibold text-[color:var(--nepal-blue)]"
                        style="font-family: var(--font-title);"
                      >
                        #{tag}
                      </span>
                    ) : (
                      <a
                        href={`/blog/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`}
                        class="text-sm text-[color:var(--text-secondary)] transition-colors duration-200 hover:text-[color:var(--secondary)]"
                        style="font-family: var(--font-title);"
                      >
                        #{tag}
                      </a>
                    )
                  )}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>
