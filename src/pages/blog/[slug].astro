---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { BlogMeta, Prose } from '@/components/ui';
import SubtleLink from '@/components/ui/navigation/SubtleLink.astro';
import { getMDXComponents } from '@/lib/mdx-components';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post: CollectionEntry<'blog'>) => ({
    params: { slug: post.data.slug ?? post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props as Props;
const { Content } = await render(post);

function calculateReadingTime(body: string): string {
  const wordsPerMinute = 200;
  const words = body.trim().split(/\s+/).length;
  const minutes = Math.ceil(words / wordsPerMinute);
  return `${minutes} min read`;
}

const readingTime = calculateReadingTime(post.body ?? '');
---

<BaseLayout title={`${post.data.title} - Tech For Nepal`}>
  <main class="flex-1 pt-24 pb-16">
    <div class="mx-auto max-w-3xl px-4">
      <SubtleLink href="/blog">&larr; BACK TO BLOG</SubtleLink>

      <article class="mt-6 sm:mt-10">
        <header>
          <h1
            class="text-2xl font-semibold tracking-tight sm:text-4xl"
            style="font-family: var(--font-title);"
          >
            {post.data.title}
          </h1>

          <div class="mt-4 sm:mt-6">
            <BlogMeta
              author={post.data.author}
              date={post.data.publishDate?.toISOString()}
              readingTime={readingTime}
              tags={post.data.tags}
            />
          </div>
        </header>

        <div class="mt-6 sm:mt-10">
          <Prose>
            <Content components={getMDXComponents()} />
          </Prose>
        </div>
      </article>
    </div>
  </main>
</BaseLayout>
