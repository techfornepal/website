---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Page Not Found">
  <main
    class="flex flex-1 items-center justify-center px-4"
    style="min-height: calc(100vh - 80px - 64px);"
  >
    <div class="mx-auto max-w-md text-center">
      <div
        class="text-8xl leading-none font-bold text-[color:var(--text-muted)]/20 select-none"
        style="font-family: var(--font-title);"
      >
        404
      </div>
      <h1
        class="mt-6 text-3xl font-semibold tracking-tight sm:text-4xl"
        style="font-family: var(--font-title);"
      >
        Page Not Found
      </h1>
      <p class="mt-4 text-[color:var(--text-muted)]">
        The page you&rsquo;re looking for doesn&rsquo;t exist or has been moved.
      </p>
      <a
        href="/"
        class="mt-8 inline-flex items-center gap-1.5 text-sm text-[color:var(--text-secondary)] transition-colors hover:text-[color:var(--text-primary)]"
        style="font-family: var(--font-title);"
      >
        &larr; Go Home
      </a>
    </div>
  </main>
</BaseLayout>
